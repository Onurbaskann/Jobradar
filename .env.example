# --- Veritabanı ---
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobradar
# Host makinede DB'nin açılacağı port. Makinende başka bir Postgres varsa değiştir.
POSTGRES_PORT=5432
# Uygulama içinden: docker compose ağında host "db"
DATABASE_URL=postgresql+psycopg://jobradar:change-me@db:5432/jobradar
#
# CLI'ı host'tan (docker dışında) çalıştırıyorsan bunu kullan.
# DİKKAT: "localhost" DEĞİL, "127.0.0.1" yaz. Windows'ta localhost önce IPv6'ya
# (::1) çözülüyor, konteyner ise yalnızca IPv4 dinliyor; bağlantı TCP zaman
# aşımına kadar bekliyor. Ölçüldü: localhost 180 sn, 127.0.0.1 0.0 sn.
# DATABASE_URL=postgresql+psycopg://jobradar:change-me@127.0.0.1:5432/jobradar

# --- Modeller ---
# Varsayılan model yerel Qwen'dir: ücretsizdir ve veri makineden çıkmaz.
# İsteğe bağlı bulut sağlayıcısı kullanılırsa ANTHROPIC_API_KEY tanımlanabilir.
ANTHROPIC_API_KEY=

# Kariyer.net, Secretcv ve Yenibiriş sonuçlarını resmi web aramasıyla bulur.
# Anahtar: https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=

# İlan çıkarımı: mekanik bir iş, yerel model bunu tam isabetle yaptı
MODEL_EXTRACT=ollama:qwen3:8b
# Kariyer sayfası/ATS bulma: Brave arar, yerel model sonuçları yorumlar
MODEL_DETECT=ollama:qwen3:8b
# İlan-CV eşleştirme puanı
MODEL_SCORE=ollama:qwen3:8b
# CV uyarlama ve ön yazı: insan okuyacak, yazı kalitesi önemli
MODEL_TAILOR=ollama:qwen3:8b

# --- Ollama (yerel model kullanıyorsan) ---
# "localhost" değil 127.0.0.1 — yukarıdaki IPv6 notunun aynısı geçerli
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=900

# --- Tarama davranışı ---
# Kendini tanıtan User-Agent: sitelerin bizi tanıyıp iletişime geçebilmesi için
CRAWLER_USER_AGENT=jobradar/0.1 (+mailto:baskanonurr@gmail.com)
# Aynı alan adına ardışık istekler arası minimum bekleme (saniye)
CRAWL_DOMAIN_DELAY=2.0
CRAWL_TIMEOUT=20.0
CRAWL_CONCURRENCY=8
RESPECT_ROBOTS_TXT=true

# --- Panel ---
PANEL_HOST=0.0.0.0
PANEL_PORT=8000

# --- Gönderim (Faz 6) ---
# İlk testlerde gerçek gönderim yerine Gmail taslağı oluşturulur
DELIVERY_DRY_RUN=true
GMAIL_CREDENTIALS_PATH=./secrets/gmail_client_secret.json
GMAIL_TOKEN_PATH=./secrets/gmail_token.json
