{
  "name": "jobradar-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "generate:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
